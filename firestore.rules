rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Müll-Kalender: alle angemeldeten Nutzer duerfen lesen, nur der Admin darf schreiben
    match /kehrwoche/schedule {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == "admin@kehrwoche-stetten.app";
    }

    // Namens-Identitaeten: jeder angemeldete Nutzer darf lesen/schreiben.
    // Mehrere Geraete duerfen gleichzeitig dieselbe Familie sein (z.B. Mann + Frau) -
    // es gibt keine Exklusiv-Sperre mehr. Das Dokument speichert nur noch einen
    // "zuletzt aktiv"-Zeitstempel je Familie (Heartbeat, siehe updatePresence() im Client).
    match /kehrwoche/identities {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Info-Tafel: alle duerfen lesen & posten, nur der Admin darf loeschen/aendern
    match /messages/{msgId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if false;
      allow delete: if request.auth != null && request.auth.token.email == "admin@kehrwoche-stetten.app";
    }

    // Push-Benachrichtigungs-Tokens: nur die Cloud Function (Admin SDK, umgeht Regeln)
    // liest diese Sammlung. Jeder angemeldete Nutzer darf sein eigenes Geraet registrieren.
    match /pushTokens/{tokenId} {
      allow read: if false;
      allow write: if request.auth != null;
    }

    // Bewohner-Rotation: alle duerfen lesen, nur der Admin darf Familien hinzufuegen/entfernen
    match /kehrwoche/rotation {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == "admin@kehrwoche-stetten.app";
    }

    // Beitritts-Konflikte: wird geschrieben, wenn jemand einer bereits aktiven Familie
    // "beitritt" - die Cloud Function benachrichtigt dann die bestehenden Geraete per Push.
    // Nur die Cloud Function (Admin SDK, umgeht Regeln) liest diese Sammlung.
    match /identityConflicts/{id} {
      allow read: if false;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }
  }
}
