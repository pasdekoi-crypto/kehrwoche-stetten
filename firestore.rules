rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Müll-Kalender: alle angemeldeten Nutzer duerfen lesen, nur der Admin darf schreiben
    match /kehrwoche/schedule {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == "admin@kehrwoche-stetten.app";
    }

    // Namens-Identitaeten: jeder angemeldete Nutzer darf lesen/schreiben,
    // um seinen eigenen Familiennamen zu waehlen oder freizugeben.
    // (Bekannte Einschraenkung: dieses Dokument ist nicht feingranular pro Familie
    // geschuetzt, "Namen freigeben" im Admin-Bereich ist dadurch nicht staerker
    // abgesichert als jeder andere Schreibzugriff hier.)
    match /kehrwoche/identities {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Info-Tafel: alle duerfen lesen & posten, nur der Admin darf loeschen/aendern
    match /messages/{msgId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if false;
      allow delete: if request.auth != null && request.auth.token.email == "admin@kehrwoche-stetten.app";
    }
  }
}
